{% extends "skeleton.jinja" %}

{% block title %}Not found{% endblock %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">{% include "mark.svg" %}Outflow</a>
        </div>
    </header>

    <main class="page page--narrow error">
        <p class="error__code">404</p>
        <h1>Not found</h1>
        <p class="lead">The page you are looking for does not exist.</p>
        <a href="{{ url_for('index') }}" class="btn">Go home</a>
    </main>
{% endblock %}
