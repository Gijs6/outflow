{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block title %}Not found{% endblock %}
{% block body_class %}page page--bare{% endblock %}

{% block body_content %}
    <main class="page__main">
        <p class="error__code">404</p>
        <h1>Not found</h1>
        <p class="lead">The page you are looking for does not exist.</p>
        <a href="{{ url_for('index') }}" class="button">{{ icon("cloud-sun") }} Go home</a>
    </main>
{% endblock %}
