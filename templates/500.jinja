{% extends "skeleton.jinja" %}

{% block title %}Server error{% endblock %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">{% include "mark.svg" %}Outflow</a>
        </div>
    </header>

    <main class="page page--narrow error">
        <p class="error__code">500</p>
        <h1>Something went wrong</h1>
        <p class="lead">An unexpected error occurred. Try again in a moment.</p>
        <a href="{{ url_for('index') }}" class="btn">Go home</a>
    </main>
{% endblock %}
