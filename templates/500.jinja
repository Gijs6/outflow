{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block title %}Server error{% endblock %}
{% block body_class %}page page--bare{% endblock %}

{% block body_content %}
    <main class="page__main">
        <p class="error__code">500</p>
        <h1>Something went wrong</h1>
        <p class="lead">An unexpected error occurred. Try again in a moment.</p>
        <a href="{{ url_for('index') }}" class="button">{{ icon("cloud-sun") }} Go home</a>
    </main>
{% endblock %}
