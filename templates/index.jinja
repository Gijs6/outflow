{% extends "base.jinja" %}

{% from "_macros.jinja" import place_meta %}

{% block title %}Home{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Weather</h1>
    </div>

    <p class="lead">Search for any city, or enter a pair of coordinates.</p>

    <div class="home__search">
        <form action="{{ url_for('search') }}"
              method="get"
              role="search"
              aria-label="Place search"
              class="field home__search-form">
            <label class="field__label" for="home-search-input">Search for a place</label>
            <input id="home-search-input"
                   type="search"
                   name="q"
                   placeholder="Amsterdam, London, New York"
                   autocomplete="off"
                   aria-autocomplete="list"
                   aria-controls="home-search-results"
                   hx-get="{{ url_for('search') }}"
                   hx-trigger="input changed delay:300ms"
                   hx-target="#home-search-results"
                   hx-indicator="#home-search-status" />
            <span id="home-search-status"
                  class="field__hint htmx-indicator"
                  aria-hidden="true">Searching...</span>
        </form>
        <div id="home-search-results"
             class="home__search-dropdown search-dropdown-wrap"
             role="listbox"
             aria-label="Search suggestions"></div>
    </div>

    <div class="form__actions home__actions">
        <button type="button" class="btn" id="home-geo-btn">Use my location</button>
        <a href="{{ url_for('lucky') }}" class="btn">Feeling lucky</a>
    </div>

    {% if favourite_places %}
        <nav class="panel" aria-label="Favourite places">
            <h2 class="panel__heading">Favourites</h2>
            <ul class="list">
                {% for place in favourite_places %}
                    <li class="list__item place-row">
                        <span>
                            <a href="{{ url_for('weather', place_id=place.place_id) }}" class="place-row__name">{{ place.name }}</a>
                            {% if place.state or place.country %}<span class="muted">{{ place_meta(place) }}</span>{% endif %}
                        </span>
                        <span class="place-weather place-weather--loading"
                              hx-get="{{ url_for('place_weather_mini', place_id=place.place_id) }}"
                              hx-trigger="load"
                              hx-swap="outerHTML"></span>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}

    {% if recent_places %}
        <nav class="panel" id="home-recents" aria-label="Recently viewed places">
            <h2 class="panel__heading">
                Recent
                <button class="btn btn--sm"
                        hx-post="{{ url_for('clear_recents') }}"
                        hx-target="#home-recents"
                        hx-swap="outerHTML">Clear</button>
            </h2>
            <ul class="list">
                {% for place in recent_places %}
                    <li class="list__item place-row">
                        <span>
                            <a href="{{ url_for('weather', place_id=place.place_id) }}" class="place-row__name">{{ place.name }}</a>
                            {% if place.state or place.country %}<span class="muted">{{ place_meta(place) }}</span>{% endif %}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}

    {% if suggested_cities %}
        <nav class="panel" aria-label="Suggested places">
            <h2 class="panel__heading">Discover</h2>
            <p class="panel__body">
                {% for place in suggested_cities -%}
                    <a href="{{ url_for('weather', place_id=place.place_id) }}">{{ place.name }}</a>
                    {%- if not loop.last %}, {% endif %}
                {% endfor %}
            </p>
        </nav>
    {% endif %}

    <p class="muted">{{ db_stats.city_count | thousands }} cities across {{ db_stats.country_count }} countries</p>
{% endblock %}

{% block extra_scripts %}
            <script>
                (function() {
                    setupSearchDropdown(
                        document.getElementById("home-search-input"),
                        document.getElementById("home-search-results")
                    );

                    var geoBtn = document.getElementById("home-geo-btn");
                    if (geoBtn) {
                        geoBtn.addEventListener("click", function() {
                            if (!navigator.geolocation) return;
                            geoBtn.disabled = true;
                            geoBtn.textContent = "Locating...";
                            navigator.geolocation.getCurrentPosition(
                                function(pos) {
                                    window.location.href = "/goto/" + pos.coords.latitude + "," + pos.coords.longitude;
                                },
                                function() {
                                    geoBtn.disabled = false;
                                    geoBtn.textContent = "Use my location";
                                }
                            );
                        });
                    }

                    if (window.matchMedia("(hover: hover)").matches) {
                        var el = document.getElementById("home-search-input");
                        if (el) el.focus();
                    }
                }());
            </script>
        {% endblock %}
