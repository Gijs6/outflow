{% extends "base.jinja" %}

{% block title %}{% if query %}{{ query }} - {% endif %}Search{% endblock %}

{% block header_search %}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Search</h1>
    </div>

    <div class="home__search">
        <form action="{{ url_for('search') }}"
              method="get"
              role="search"
              aria-label="Place search"
              class="field home__search-form">
            <label class="field__label" for="search-page-input">Search for a place</label>
            <input id="search-page-input"
                   type="search"
                   name="q"
                   value="{{ query }}"
                   placeholder="Amsterdam, London, New York"
                   autocomplete="off"
                   aria-autocomplete="list"
                   aria-controls="search-page-dropdown"
                   hx-get="{{ url_for('search') }}"
                   hx-trigger="input changed delay:300ms"
                   hx-target="#search-page-dropdown"
                   hx-indicator="#search-page-status" />
            <span id="search-page-status"
                  class="field__hint htmx-indicator"
                  aria-hidden="true">Searching...</span>
        </form>
        <div id="search-page-dropdown"
             class="search-page__dropdown search-dropdown-wrap"
             role="listbox"></div>
    </div>

    {% if query %}
        {% if error %}
            <div class="alert alert--danger">
                <p>Search is unavailable right now.</p>
            </div>
        {% elif places %}
            <section class="panel">
                <h2 class="panel__heading">Results ({{ places | length }})</h2>
                <ul class="list">
                    {% for place in places %}
                        <li class="list__item place-row">
                            <span>
                                <a href="{{ url_for('weather', place_id=place.place_id) }}"
                                   class="place-row__name">{{ place.name }}</a>
                                <span class="muted">
                                    {%- if place.is_direct -%}
                                        Coordinates
                                    {%- elif place.state -%}
                                        {{ place.state }}, {{ place.country }}
                                    {%- else -%}
                                        {{ place.country }}
                                    {%- endif -%}
                                </span>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="empty">
                <p class="empty__title">No results</p>
                <p>No place matches "{{ query }}".</p>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block extra_scripts %}
    <script>
        (function() {
            setupSearchDropdown(
                document.getElementById("search-page-input"),
                document.getElementById("search-page-dropdown")
            );
        }());
    </script>
{% endblock %}
