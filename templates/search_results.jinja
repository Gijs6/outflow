{% if error %}
    <p class="search-dropdown__note search-dropdown__note--error">Search is unavailable right now.</p>
{% elif places %}
    <ul class="search-dropdown" role="listbox" aria-label="Search results">
        {% for place in places %}
            <li class="search-dropdown__item" role="option">
                <a href="{{ url_for('weather', place_id=place.place_id) }}"
                   class="search-dropdown__row">
                    <span class="search-dropdown__name">{{ place.name }}</span>
                    <span class="search-dropdown__meta">
                        {%- if place.is_direct -%}
                            Coordinates
                        {%- elif place.state -%}
                            {{ place.state }}, {{ place.country }}
                        {%- else -%}
                            {{ place.country }}
                        {%- endif -%}
                    </span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="search-dropdown__note">No place matches "{{ query }}".</p>
{% endif %}
