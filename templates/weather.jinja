{% extends "base.jinja" %}

{% block title %}{{ name }}{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ name }}</h1>
            {% if state or country_name %}<p class="page-head__sub">{{ [state, country_name] | select | join(", ") }}</p>{% endif %}
        </div>
        <div class="page-head__actions">
            {% include "weather/favourite_btn.jinja" %}
        </div>
    </div>

    <section id="weather-island"
             data-error-inline
             class="island island--loading"
             hx-get="{{ island_url }}"
             hx-trigger="load"
             hx-swap="innerHTML">
        <p class="muted">Loading weather...</p>
    </section>
{% endblock %}
