{% from "_macros.jinja" import icon %}
<form class="favourite-form"
      method="post"
      action="{{ url_for('toggle_favourite', place_id=place_id) }}"
      hx-post="{{ url_for('toggle_favourite', place_id=place_id) }}"
      hx-swap="outerHTML">
    <input type="hidden" name="name" value="{{ name }}">
    <input type="hidden" name="state" value="{{ state }}">
    <input type="hidden" name="country" value="{{ country_name }}">
    <button type="submit"
            class="icon-button favourite-btn{% if is_favourite %} is-active{% endif %}"
            aria-pressed="{{ 'true' if is_favourite else 'false' }}"
            aria-label="{{ 'Remove from favourites' if is_favourite else 'Add to favourites' }}">{{ icon("star") }}</button>
</form>
