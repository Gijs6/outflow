{% from "_macros.jinja" import icon, weather_icon %}
{% set tz = weather.timezone %}
{% set hourly_data = hourly_forecast if hourly_forecast else weather.hourly if weather.hourly else [] %}
{% set daily_data = daily_16 if daily_16 else weather.daily if weather.daily else [] %}
{% set alerts = alerts if alerts else [] %}
{% set aqi_labels = {1: 'good', 2: 'fair', 3: 'moderate', 4: 'poor', 5: 'very poor'} %}
{% set aqi_tone = {1: 'ok', 2: 'ok', 3: 'warn', 4: 'bad', 5: 'bad'} %}
{% set current_code = weather.current.weather[0].icon %}

<div class="weather island__content" data-title="{{ name }}">

    <div id="weather-tz" data-tz="{{ tz }}" hidden></div>
    <div id="weather-coords" data-lat="{{ lat }}" data-lon="{{ lon }}" hidden></div>

    {% if hourly_data %}
        {# djlint:off #}
        <script id="hourly-data" type="application/json">{{ hourly_data[: 96] | tojson }}</script>
        {# djlint:on #}
    {% endif %}
    {% if minutely %}
        {# djlint:off #}
        <script id="minutely-data" type="application/json">{{ minutely | tojson }}</script>
        {# djlint:on #}
    {% endif %}

    {% set place_parts = [location.state, country_name] | select | list %}
    <div class="place-head">
        <div class="place-head__titles">
            <h1>{{ location.name or "%.4f, %.4f" | format(lat, lon) }}</h1>
            {% if place_parts %}<p class="place-head__place">{{ place_parts | join(", ") }}</p>{% endif %}
            <p class="place-head__time">
                <time datetime="{{ weather.current.dt | to_iso(tz) }}">{{ weather.current.dt | strftime("%a %-d %b %Y, %H:%M", tz) }}</time>
            </p>
        </div>
        {% include "weather/favourite_btn.jinja" %}

    </div>

    <div class="conditions">
        {{ weather_icon(current_code, "conditions__glyph") }}
        <p class="conditions__temp">
            <data value="{{ weather.current.temp }}">{{ weather.current.temp | round(1) }}°</data>
        </p>
        <div class="conditions__meta">
            <p class="conditions__desc">{{ weather.current.weather | map(attribute='description') | join(', ') | ucfirst }}</p>
            <p class="conditions__feels">
                feels like <data value="{{ weather.current.feels_like }}">{{ weather.current.feels_like | round | int }}°</data>
            </p>
        </div>
    </div>

    <dl class="readings">
        <div>
            <dt>Wind</dt>
            <dd>
                {{ weather.current.wind_speed | to_bft }} bft {{ weather.current.wind_deg | wind_dir }}
            </dd>
        </div>
        {% if weather.current.wind_gust %}
            <div>
                <dt>Gusts</dt>
                <dd>
                    {{ weather.current.wind_gust | to_bft }} bft
                </dd>
            </div>
        {% endif %}
        <div>
            <dt>Humidity</dt>
            <dd>
                {{ weather.current.humidity }}%
            </dd>
        </div>
        <div>
            <dt>Dew point</dt>
            <dd>
                {{ weather.current.dew_point | round | int }}°
            </dd>
        </div>
        <div>
            <dt>Pressure</dt>
            <dd>
                {{ weather.current.pressure }} hPa
            </dd>
        </div>
        <div>
            <dt>Visibility</dt>
            <dd>
                {{ (weather.current.visibility / 1000) | round(1) }} km
            </dd>
        </div>
        <div>
            <dt>Cloud cover</dt>
            <dd>
                {{ weather.current.clouds }}%
            </dd>
        </div>
        {% if weather.current.uvi is defined %}
            <div>
                <dt>UV index</dt>
                <dd>
                    {{ "%.0f" | format(weather.current.uvi) }}
                </dd>
            </div>
        {% endif %}
        <div>
            <dt>Sunrise</dt>
            <dd>
                <time datetime="{{ weather.current.sunrise | to_iso(tz) }}">{{ weather.current.sunrise | strftime("%H:%M", tz) }}</time>
            </dd>
        </div>
        <div>
            <dt>Sunset</dt>
            <dd>
                <time datetime="{{ weather.current.sunset | to_iso(tz) }}">{{ weather.current.sunset | strftime("%H:%M", tz) }}</time>
            </dd>
        </div>
        {% if weather.current.rain %}
            <div>
                <dt>Rain</dt>
                <dd>
                    {{ weather.current.rain['1h'] }} mm/h
                </dd>
            </div>
        {% endif %}
        {% if weather.current.snow %}
            <div>
                <dt>Snow</dt>
                <dd>
                    {{ weather.current.snow['1h'] }} mm/h
                </dd>
            </div>
        {% endif %}
        {% if air_pollution %}
            {% set aqi = air_pollution.list[0].main.aqi %}
            <div>
                <dt>Air quality</dt>
                <dd class="readings__flag readings__flag--{{ aqi_tone.get(aqi, 'warn') }}">
                    {{ aqi_labels.get(aqi, aqi) }}
                </dd>
            </div>
        {% endif %}
    </dl>

    {% if minutely %}
        {% set ns = namespace(first=-1, last=-1, max_p=0) %}
        {% for m in minutely %}
            {% if m.precipitation > 0 %}
                {% if ns.first == -1 %}
                    {% set ns.first = loop.index0 %}
                {% endif %}
                {% set ns.last = loop.index0 %}
            {% endif %}
            {% if m.precipitation > ns.max_p %}
                {% set ns.max_p = m.precipitation %}
            {% endif %}
        {% endfor %}
        <section class="rain">
            <p class="rain__label">
                {% if ns.first == -1 %}
                    No rain expected in the next hour
                {% elif ns.first == 0 and ns.last >= 58 %}
                    Rain throughout the next hour, up to {{ "%.1f" | format(ns.max_p) }} mm/h
                {% elif ns.first == 0 %}
                    Rain now, easing around +{{ ns.last + 1 }} min, up to {{ "%.1f" | format(ns.max_p) }} mm/h
                {% elif ns.last >= 58 %}
                    Rain starting in about {{ ns.first }} min, up to {{ "%.1f" | format(ns.max_p) }} mm/h
                {% else %}
                    Rain from about {{ ns.first }} to {{ ns.last + 1 }} min, up to {{ "%.1f" | format(ns.max_p) }} mm/h
                {% endif %}
            </p>
            {% if ns.first != -1 %}
                <div class="rain__strip" aria-hidden="true">
                    {% for m in minutely %}
                        {% set p = m.precipitation %}
                        {% if p <= 0 %}
                            {% set level = 0 %}
                        {% elif p < 0.5 %}
                            {% set level = 1 %}
                        {% elif p < 2 %}
                            {% set level = 2 %}
                        {% elif p < 5 %}
                            {% set level = 3 %}
                        {% else %}
                            {% set level = 4 %}
                        {% endif %}
                        <span class="rain__seg" data-level="{{ level }}"></span>
                    {% endfor %}
                </div>
                <div class="rain__axis" aria-hidden="true">
                    <span>now</span><span>+30 min</span><span>+60 min</span>
                </div>
            {% endif %}
        </section>
    {% endif %}

    {% if alerts %}
        {% set ev0 = alerts[0].event | lower | trim %}
        {% set alert_kind = "danger" if ev0[:7] == "extreme" else "warning" %}
        {% set alert_extra = alerts | length - 1 %}
        {% set alert_headline = alerts[0].event | trim ~ (", and " ~ alert_extra ~ " more" if alert_extra else "") ~ "." %}
        <div class="notice notice--{{ alert_kind }}" role="alert">
            {{ icon('triangle-alert', 'notice__icon') }}
            <div class="notice__body">
                <p>
                    <strong>{{ alert_headline }}</strong>
                    <a href="#alerts" data-tab-target="alerts">View {{ "alerts" if alert_extra else "alert" }}</a>
                </p>
            </div>
        </div>
    {% endif %}

    <nav class="forecast-tabs" aria-label="Weather sections">
        <div class="tabs" role="tablist" id="weather-tablist">
            <button role="tab"
                    id="tab-btn-overview"
                    aria-selected="true"
                    aria-controls="tab-panel-overview"
                    tabindex="0"
                    class="tabs__tab is-active"
                    data-tab="overview">Overview</button>
            <button role="tab"
                    id="tab-btn-hourly"
                    aria-selected="false"
                    aria-controls="tab-panel-hourly"
                    tabindex="-1"
                    class="tabs__tab"
                    data-tab="hourly">Hourly</button>
            <button role="tab"
                    id="tab-btn-daily"
                    aria-selected="false"
                    aria-controls="tab-panel-daily"
                    tabindex="-1"
                    class="tabs__tab"
                    data-tab="daily">{{ daily_data | length }}-day</button>
            <button role="tab"
                    id="tab-btn-air"
                    aria-selected="false"
                    aria-controls="tab-panel-air"
                    tabindex="-1"
                    class="tabs__tab"
                    data-tab="air">Air quality</button>
            <button role="tab"
                    id="tab-btn-map"
                    aria-selected="false"
                    aria-controls="tab-panel-map"
                    tabindex="-1"
                    class="tabs__tab"
                    data-tab="map">Map</button>
            {% if alerts %}
                <button role="tab"
                        id="tab-btn-alerts"
                        aria-selected="false"
                        aria-controls="tab-panel-alerts"
                        tabindex="-1"
                        class="tabs__tab"
                        data-tab="alerts">
                    Alerts <span class="count count--bad">{{ alerts | length }}</span>
                </button>
            {% endif %}
        </div>
    </nav>

    <section role="tabpanel"
             id="tab-panel-overview"
             aria-labelledby="tab-btn-overview"
             class="tab-panel forecast-panel">
        {% if hourly_data %}
            <section class="forecast-block">
                <h2>Next 2 days</h2>
                <div class="reel hourly-reel"
                     id="overview-hourly-strip"
                     aria-label="Hourly forecast"></div>
            </section>
        {% endif %}

        {% if daily_data %}
            <section class="forecast-block">
                <h2>Week ahead</h2>
                <div class="table-wrap">
                    <table class="table forecast-table">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>Conditions</th>
                                <th class="th--num">Low / high</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for day in daily_data[:7] %}
                                <tr>
                                    <td>
                                        <time datetime="{{ day.dt | to_iso(tz) }}">{{ day.dt | strftime("%a %-d %b", tz) }}</time>
                                    </td>
                                    <td class="forecast-table__cond">{{ weather_icon(day.weather[0].icon) }} {{ day.weather | map(attribute='description') | join(', ') | ucfirst }}</td>
                                    <td class="td--num">{{ day.temp.min | round | int }}° / {{ day.temp.max | round | int }}°</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endif %}
    </section>

    <section role="tabpanel"
             id="tab-panel-hourly"
             aria-labelledby="tab-btn-hourly"
             class="tab-panel forecast-panel"
             hidden>
        {% if hourly_data %}
            <div class="reel hourly-reel"
                 id="hourly-reel"
                 aria-label="Coming days at a glance"></div>
            <div class="table-wrap">
                <table class="table hour-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Sky</th>
                            <th class="th--num">Temp</th>
                            <th class="th--num">Feels</th>
                            <th class="th--num">Precip</th>
                            <th>Wind</th>
                        </tr>
                    </thead>
                    <tbody id="hourly-table-body">
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="forecast-empty">Hourly data is unavailable for this place.</p>
        {% endif %}
    </section>

    <section role="tabpanel"
             id="tab-panel-daily"
             aria-labelledby="tab-btn-daily"
             class="tab-panel forecast-panel"
             hidden>
        {% if daily_data %}
            <div class="accordion day-list">
                {% for day in daily_data %}
                    <details class="accordion__item">
                        <summary>
                            <span class="day-list__day">
                                <time datetime="{{ day.dt | to_iso(tz) }}">{{ day.dt | strftime("%a %-d %b", tz) }}</time>
                            </span>
                            {{ weather_icon(day.weather[0].icon) }}
                            <span class="day-list__desc">{{ day.weather | map(attribute='description') | join(', ') | ucfirst }}</span>
                            <span class="day-list__temps">{{ day.temp.min | round | int }}° / {{ day.temp.max | round | int }}°</span>
                        </summary>
                        <div class="accordion__panel">
                            {% if day.summary is defined and day.summary %}<p class="day-list__note">{{ day.summary | ucfirst }}</p>{% endif %}
                            <dl class="data-list">
                                <dt>Precip chance</dt>
                                <dd>
                                    {{ (day['pop'] * 100) | round | int }}%
                                </dd>
                                <dt>Daytime</dt>
                                <dd>
                                    morning {{ day.temp.morn | round | int }}°, day {{ day.temp.day | round | int }}°, evening {{ day.temp.eve | round | int }}°, night {{ day.temp.night | round | int }}°
                                </dd>
                                {% if day.feels_like %}
                                    <dt>Feels like</dt>
                                    <dd>
                                        morning {{ day.feels_like.morn | round | int }}°, day {{ day.feels_like.day | round | int }}°, evening {{ day.feels_like.eve | round | int }}°, night {{ day.feels_like.night | round | int }}°
                                    </dd>
                                {% endif %}
                                <dt>Wind</dt>
                                <dd>
                                    {{ day.wind_speed | to_bft }} bft
                                    {% if day.wind_gust %}, gusts {{ day.wind_gust | to_bft }} bft{% endif %}
                                </dd>
                                <dt>Humidity</dt>
                                <dd>
                                    {{ day.humidity }}%
                                </dd>
                                <dt>Cloud cover</dt>
                                <dd>
                                    {{ day.clouds }}%
                                </dd>
                                {% if day.uvi %}
                                    <dt>UV index</dt>
                                    <dd>
                                        {{ "%.1f" | format(day.uvi) }}
                                    </dd>
                                {% endif %}
                                <dt>Pressure</dt>
                                <dd>
                                    {{ day.pressure }} hPa
                                </dd>
                                {% if day.dew_point %}
                                    <dt>Dew point</dt>
                                    <dd>
                                        {{ day.dew_point | round | int }}°
                                    </dd>
                                {% endif %}
                                {% if day.sunrise %}
                                    <dt>Sunrise</dt>
                                    <dd>
                                        <time datetime="{{ day.sunrise | to_iso(tz) }}">{{ day.sunrise | strftime("%H:%M", tz) }}</time>
                                    </dd>
                                {% endif %}
                                {% if day.sunset %}
                                    <dt>Sunset</dt>
                                    <dd>
                                        <time datetime="{{ day.sunset | to_iso(tz) }}">{{ day.sunset | strftime("%H:%M", tz) }}</time>
                                    </dd>
                                {% endif %}
                                {% if day.rain %}
                                    <dt>Rain</dt>
                                    <dd>
                                        {{ day.rain | round(1) }} mm
                                    </dd>
                                {% elif day.snow %}
                                    <dt>Snow</dt>
                                    <dd>
                                        {{ day.snow | round(1) }} mm
                                    </dd>
                                {% endif %}
                            </dl>
                        </div>
                    </details>
                {% endfor %}
            </div>
        {% else %}
            <p class="forecast-empty">Daily forecast is unavailable for this place.</p>
        {% endif %}
    </section>

    <section role="tabpanel"
             id="tab-panel-air"
             aria-labelledby="tab-btn-air"
             class="tab-panel forecast-panel"
             hidden>
        {% if air_pollution %}
            {% set aqi = air_pollution.list[0].main.aqi %}
            {% set comp = air_pollution.list[0].components %}
            <div class="aqi">
                <span class="aqi__badge aqi__badge--{{ aqi_tone.get(aqi, 'warn') }}">{{ aqi_labels.get(aqi, "unknown") | ucfirst }}</span>
                <span class="aqi__sub">air quality index {{ aqi }} of 5</span>
            </div>
            <section class="forecast-block">
                <h2>Pollutants</h2>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Pollutant</th>
                                <th class="th--num">Concentration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Fine particles (PM2.5)</td>
                                <td class="td--num">{{ "%.1f" | format(comp.pm2_5) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Coarse particles (PM10)</td>
                                <td class="td--num">{{ "%.1f" | format(comp.pm10) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Ozone (O3)</td>
                                <td class="td--num">{{ "%.1f" | format(comp.o3) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Nitrogen dioxide (NO2)</td>
                                <td class="td--num">{{ "%.1f" | format(comp.no2) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Sulphur dioxide (SO2)</td>
                                <td class="td--num">{{ "%.1f" | format(comp.so2) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Carbon monoxide (CO)</td>
                                <td class="td--num">{{ "%.0f" | format(comp.co) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Nitrogen monoxide (NO)</td>
                                <td class="td--num">{{ "%.2f" | format(comp.no) }} ug/m3</td>
                            </tr>
                            <tr>
                                <td>Ammonia (NH3)</td>
                                <td class="td--num">{{ "%.2f" | format(comp.nh3) }} ug/m3</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        {% else %}
            <p class="forecast-empty">Air quality data is unavailable for this place.</p>
        {% endif %}
    </section>

    <section role="tabpanel"
             id="tab-panel-map"
             aria-labelledby="tab-btn-map"
             class="tab-panel forecast-panel forecast-panel--map"
             hidden>
        <div class="segmented map-layers" role="group" aria-label="Map layer">
            {% set layers = [('precipitation_new', 'Precipitation'), ('temp_new', 'Temperature'), ('clouds_new', 'Clouds'), ('wind_new', 'Wind'), ('pressure_new', 'Pressure')] %}
            {% for layer_id, layer_label in layers %}
                <button type="button"
                        class="map-layers__btn{% if loop.first %} is-active{% endif %}"
                        data-layer="{{ layer_id }}"
                        aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ layer_label }}</button>
            {% endfor %}
        </div>
        <div id="weather-map"
             class="map-canvas"
             aria-label="Interactive weather map"></div>
    </section>

    {% if alerts %}
        <section role="tabpanel"
                 id="tab-panel-alerts"
                 aria-labelledby="tab-btn-alerts"
                 class="tab-panel forecast-panel"
                 hidden>
            {% for alert in alerts %}
                {% set ev = alert.event | lower | trim %}
                {% set kind = "danger" if ev[:7] == "extreme" else "warning" %}
                <article class="notice notice--{{ kind }} notice--loud alert"
                         id="alert-{{ alert.start }}">
                    {{ icon('triangle-alert', 'notice__icon') }}
                    <div class="notice__body">
                        <p class="notice__title">{{ alert.event }}</p>
                        <p class="alert__source">Issued by {{ alert.sender_name }}</p>
                        <dl class="data-list alert__times">
                            <dt>From</dt>
                            <dd>
                                <time datetime="{{ alert.start | to_iso(tz) }}">{{ alert.start | strftime("%a %-d %b, %H:%M", tz) }}</time>
                            </dd>
                            <dt>Until</dt>
                            <dd>
                                <time datetime="{{ alert.end | to_iso(tz) }}">{{ alert.end | strftime("%a %-d %b, %H:%M", tz) }}</time>
                            </dd>
                        </dl>
                        {% if alert.description %}<p class="alert__desc">{{ alert.description }}</p>{% endif %}
                        {% if alert.tags %}
                            <ul class="cluster alert__tags" aria-label="Alert tags">
                                {% for tag in alert.tags %}
                                    <li>
                                        <span class="badge">{{ tag | lower }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </section>
    {% endif %}
</div>

<script>
    (function() {
        var island = document.getElementById("weather-island");
        if (island) island.classList.remove("island--loading");

        var TZ = document.getElementById("weather-tz").dataset.tz;
        var coordsEl = document.getElementById("weather-coords");
        var MAP_LAT = parseFloat(coordsEl.dataset.lat);
        var MAP_LON = parseFloat(coordsEl.dataset.lon);

        function fmtTime(d, opts) {
            return d.toLocaleString("en", Object.assign({
                timeZone: TZ,
                hour12: false
            }, opts));
        }

        function toBft(ms) {
            var t = [0.3, 1.6, 3.4, 5.5, 8.0, 10.8, 13.9, 17.2, 20.8, 24.5, 28.5, 32.7];
            for (var i = 0; i < t.length; i++)
                if (ms < t[i]) return i;
            return 12;
        }

        function windDir(deg) {
            var dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
            return dirs[Math.round(deg / 22.5) % 16];
        }

        var tablist = document.getElementById("weather-tablist");
        var activateTabFromHash = function() {};

        if (tablist) {
            var tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));

            function selectTab(tab, updateHash) {
                tabs.forEach(function(t) {
                    t.setAttribute("aria-selected", "false");
                    t.setAttribute("tabindex", "-1");
                    t.classList.remove("is-active");
                });
                tab.setAttribute("aria-selected", "true");
                tab.setAttribute("tabindex", "0");
                tab.classList.add("is-active");

                document.querySelectorAll('[role="tabpanel"]').forEach(function(p) {
                    p.hidden = true;
                });
                var panel = document.getElementById(tab.getAttribute("aria-controls"));
                if (panel) panel.hidden = false;

                if (tab.dataset.tab === "map") {
                    initMap();
                    if (mapInstance) {
                        mapInstance.invalidateSize();
                        mapInstance.setView([MAP_LAT, MAP_LON], 9);
                    }
                }
                if (tab.dataset.tab === "hourly") buildHourly();

                if (updateHash !== false) history.replaceState(null, "", "#" + tab.dataset.tab);
            }

            activateTabFromHash = function() {
                var hash = location.hash.slice(1);
                var target = hash ? tablist.querySelector('[data-tab="' + hash + '"]') : null;
                if (target) selectTab(target, false);
            };

            tabs.forEach(function(tab) {
                tab.addEventListener("click", function() {
                    selectTab(tab);
                });
                tab.addEventListener("keydown", function(e) {
                    var idx = tabs.indexOf(e.currentTarget);
                    if (e.key === "ArrowRight") {
                        e.preventDefault();
                        var n = tabs[(idx + 1) % tabs.length];
                        n.focus();
                        selectTab(n);
                    } else if (e.key === "ArrowLeft") {
                        e.preventDefault();
                        var p = tabs[(idx - 1 + tabs.length) % tabs.length];
                        p.focus();
                        selectTab(p);
                    } else if (e.key === "Home") {
                        e.preventDefault();
                        tabs[0].focus();
                        selectTab(tabs[0]);
                    } else if (e.key === "End") {
                        e.preventDefault();
                        tabs[tabs.length - 1].focus();
                        selectTab(tabs[tabs.length - 1]);
                    }
                });
            });

            document.querySelectorAll("[data-tab-target]").forEach(function(link) {
                link.addEventListener("click", function(e) {
                    e.preventDefault();
                    var targetTab = tablist.querySelector('[data-tab="' + link.dataset.tabTarget + '"]');
                    if (targetTab) {
                        targetTab.focus();
                        selectTab(targetTab);
                    }
                });
            });

            window.addEventListener("popstate", activateTabFromHash);
        }

        var hourlyDataEl = document.getElementById("hourly-data");

        function getDayKey(date) {
            return date.toLocaleDateString("en-CA", {
                timeZone: TZ
            });
        }

        function getDayLabel(date) {
            var now = new Date();
            var todayKey = getDayKey(now);
            var tomorrowKey = getDayKey(new Date(now.getTime() + 86400000));
            var key = getDayKey(date);
            if (key === todayKey) return "Today";
            if (key === tomorrowKey) return "Tomorrow";
            return fmtTime(date, {
                weekday: "long"
            });
        }

        function buildHourlyStrip(container) {
            if (!container || !hourlyDataEl || container.childElementCount > 0) return;

            var raw = JSON.parse(hourlyDataEl.textContent);
            var marks = raw
                .map(function(d) {
                    return {
                        date: new Date(d.dt * 1000),
                        temp: Math.round(d.temp),
                        icon: d.weather[0].icon
                    };
                })
                .filter(function(d) {
                    var hour = parseInt(d.date.toLocaleString("en", {
                        timeZone: TZ,
                        hour: "numeric",
                        hour12: false
                    }), 10);
                    return hour % 6 === 0;
                })
                .slice(0, 8);

            marks.forEach(function(h) {
                var timeStr = fmtTime(h.date, {
                    weekday: "short",
                    hour: "2-digit",
                    minute: "2-digit"
                });

                var item = document.createElement("div");
                item.className = "hourly-reel__item";
                item.innerHTML =
                    '<span class="hourly-reel__time">' + timeStr + "</span>" +
                    window.wxWeatherIcon(h.icon, "hourly-reel__glyph") +
                    '<span class="hourly-reel__temp">' + h.temp + "°</span>";
                container.appendChild(item);
            });
        }

        function buildHourlyTable(tbody) {
            if (!tbody || !hourlyDataEl || tbody.childElementCount > 0) return;

            var raw = JSON.parse(hourlyDataEl.textContent);
            var lastDay = null;
            var html = "";

            raw.forEach(function(d) {
                var date = new Date(d.dt * 1000);
                var dayKey = getDayKey(date);
                if (dayKey !== lastDay) {
                    lastDay = dayKey;
                    html += '<tr class="hour-table__day"><th colspan="6" scope="colgroup">' +
                        getDayLabel(date) + ", " + fmtTime(date, {
                            day: "numeric",
                            month: "short"
                        }) + "</th></tr>";
                }
                var popPct = Math.round((d.pop || 0) * 100);
                var timeStr = fmtTime(date, {
                    hour: "2-digit",
                    minute: "2-digit"
                });
                html += "<tr>" +
                    "<td>" + timeStr + "</td>" +
                    '<td class="hour-table__cond">' + window.wxWeatherIcon(d.weather[0].icon) + "</td>" +
                    '<td class="td--num">' + Math.round(d.temp) + "°</td>" +
                    '<td class="td--num">' + Math.round(d.feels_like) + "°</td>" +
                    '<td class="td--num">' + popPct + "%</td>" +
                    "<td>" + toBft(d.wind_speed || 0) + " bft " + windDir(d.wind_deg || 0) + "</td>" +
                    "</tr>";
            });

            tbody.innerHTML = html;
        }

        function buildHourly() {
            buildHourlyStrip(document.getElementById("hourly-reel"));
            buildHourlyTable(document.getElementById("hourly-table-body"));
        }

        buildHourlyStrip(document.getElementById("overview-hourly-strip"));
        activateTabFromHash();

        var mapInstance = null;
        var mapOverlayLayer = null;
        var currentLayer = "precipitation_new";

        function initMap() {
            if (mapInstance || window._leafletLoading) return;
            if (window.L) {
                buildMap();
                return;
            }

            window._leafletLoading = true;
            var link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = "/static/vendor/leaflet.css";
            document.head.appendChild(link);

            var script = document.createElement("script");
            script.src = "/static/vendor/leaflet.js";
            script.onload = buildMap;
            document.head.appendChild(script);
        }

        function makeOverlay() {
            return L.tileLayer("/tiles/" + currentLayer + "/{z}/{x}/{y}.png", {
                opacity: 0.6,
                attribution: '&copy; <a href="https://openweathermap.org/">OpenWeatherMap</a>'
            });
        }

        function buildMap() {
            var mapEl = document.getElementById("weather-map");
            if (!mapEl || mapInstance) return;

            mapInstance = L.map("weather-map").setView([MAP_LAT, MAP_LON], 9);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 18
            }).addTo(mapInstance);

            mapOverlayLayer = makeOverlay().addTo(mapInstance);
            L.circleMarker([MAP_LAT, MAP_LON], {
                radius: 6,
                weight: 2
            }).addTo(mapInstance);

            setTimeout(function() {
                mapInstance.invalidateSize();
                mapInstance.setView([MAP_LAT, MAP_LON], 9);
            }, 0);

            document.querySelectorAll(".map-layers__btn").forEach(function(btn) {
                btn.addEventListener("click", function() {
                    document.querySelectorAll(".map-layers__btn").forEach(function(b) {
                        b.classList.remove("is-active");
                        b.setAttribute("aria-pressed", "false");
                    });
                    btn.classList.add("is-active");
                    btn.setAttribute("aria-pressed", "true");
                    currentLayer = btn.dataset.layer;
                    if (mapOverlayLayer) mapInstance.removeLayer(mapOverlayLayer);
                    mapOverlayLayer = makeOverlay().addTo(mapInstance);
                });
            });
        }
    }());
</script>
